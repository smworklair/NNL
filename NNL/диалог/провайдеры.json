{
  "groq": {
    "base_url": "https://api.groq.com/openai/v1",
    "ключ_метка": "api groq",
    "ключ_env": "GROQ_API_KEY",
    "авторизация": "Bearer",
    "подключён": true,
    "документация": "https://console.groq.com/docs/openai",
    "документация_апи": "https://console.groq.com/docs/api-reference",
    "пояснение": "Лимит 8000 токенов в минуту на каждую модель отдельно, резервируется весь max_completion_tokens, имя схемы только из символов латинских букв цифр подчёркивания и дефиса, у моделей gpt-oss есть reasoning_effort",
    "reasoning_effort_gpt_oss": {
      "без_размышления": "low",
      "с_размышлением": "medium",
      "условие_в_имени": "gpt-oss"
    },
    "модели": [
      "openai/gpt-oss-120b",
      "qwen/qwen3-32b",
      "qwen/qwen3.8-27b"
    ]
  },
  "gemini": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "ключ_метка": "api key",
    "ключ_env": "GEMINI_API_KEY",
    "авторизация": "Bearer",
    "подключён": true,
    "документация": "https://ai.google.dev/gemini-api/docs/openai",
    "пояснение": "Бесплатные квоты часто кончаются с ошибкой превышения лимита, ответы идут от четырёх до сорока секунд. Мысли модели через этот адрес приходят только по просьбе (extra_body_размышление), в тегах thought внутри текста",
    "extra_body_размышление": {
      "extra_body": {
        "google": {
          "thinking_config": {
            "include_thoughts": true
          }
        }
      }
    },
    "модели": [
      "gemini-2.5-flash",
      "gemini-3.8-flash"
    ]
  },
  "mistral": {
    "base_url": "https://api.mistral.ai/v1",
    "ключ_метка": "MISTRAL",
    "ключ_env": "MISTRAL_API_KEY",
    "авторизация": "Bearer",
    "подключён": true,
    "документация": "https://docs.mistral.ai/resources/migration-guides",
    "пояснение": "Mistral, интерфейс совместим с OpenAI. Ключ человека, список моделей берётся у провайдера.",
    "модели": []
  },
  "alibaba": {
    "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "ключ_метка": "QWEN",
    "ключ_env": "DASHSCOPE_API_KEY",
    "авторизация": "Bearer",
    "подключён": true,
    "документация": "https://docs.modelstudio.console.alibabacloud.com/en/model-studio/compatibility-of-openai-with-dashscope",
    "документация_дополнительно": "https://docs.litellm.ai/docs/providers/dashscope",
    "пояснение": "Международный режим совместимости, международный режим, ключ под заголовком QWEN, проверено: /models отвечает, регионы cn и us ключ отвергают",
    "extra_body": {
      "enable_thinking": false
    },
    "extra_body_размышление": {
      "enable_thinking": true
    },
    "модели": [
      "qwen3.8-flash",
      "qwen3.8-27b",
      "qwen3.8-max",
      "qwen3.8-2.4t-a95b",
      "qwen3.7-max"
    ]
  },
